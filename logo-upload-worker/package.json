{
  "name": "logo-upload-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for logo file uploads with R2 storage",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "r2",
    "file-upload",
    "logo"
  ],
  "author": "Latente",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.1"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}